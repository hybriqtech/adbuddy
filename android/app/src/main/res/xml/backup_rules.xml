<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 (API 30) reads these instead of data_extraction_rules.xml:
     nothing is backed up, so the link token and the consent stay on this device. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
