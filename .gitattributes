# Los scripts de shell deben conservar LF en Windows (core.autocrlf=true rompe `source` con \r)
*.sh text eol=lf

# host/: LF siempre (gofmt no acepta CRLF y core.autocrlf=true lo pondría)
host/**/*.go text eol=lf
host/go.mod text eol=lf
host/go.sum text eol=lf
host/**/*.yaml text eol=lf
host/**/*.md text eol=lf
host/**/*.jsonl text eol=lf
host/**/*.tsv text eol=lf
host/**/testdata/** text eol=lf
.github/**/*.yml text eol=lf

# android/: LF (Gradle, Kotlin and Android resources)
android/**/*.kt text eol=lf
android/**/*.kts text eol=lf
android/**/*.xml text eol=lf
android/**/*.toml text eol=lf
android/**/*.properties text eol=lf
android/**/*.pro text eol=lf
android/**/*.md text eol=lf
android/.gitignore text eol=lf

# protocol/: the shared fixtures, read byte for byte by Go and Kotlin
protocol/** text eol=lf
